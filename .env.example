# Ascension AI - Environment Variables

# Database
DATABASE_URL=postgresql://localhost:5432/ascension_ai

# Server
PORT=3000

# Private standalone evaluation service
ASCENSION_AI_TEST_TOKEN=generate_a_long_random_private_value
ASCENSION_AI_SERVICE_TOKEN=generate_a_different_long_random_private_value
# Single founder email allowed to access the standalone lab
ASCENSION_AI_ALLOWED_EMAIL=
ASCENSION_MODEL_PROFILE=starter
ASCENSION_MODEL_CONTEXT=768
ASCENSION_MODEL_BATCH=16
ASCENSION_MODEL_THREADS=1
ASCENSION_VERIFY_MODEL_ON_BOOT=1
ASCENSION_AI_ALLOWED_ORIGINS=
